    {
      "parameters": {
        "jsCode": "\nconst r = JSON.parse($input.first().json.stdout);\n\nlet html = `\n<h1>Rapport de tournées VPR Logistics</h1>\n<h2>Résumé de l'optimisation</h2>\n\n<p><b>Distance totale :</b> ${r.distance_totale}</p>\n<p><b>Nombre de véhicules :</b> ${r.vehicules.length}</p>\n<p><b>Clients non servis :</b>\n${r.non_servis.length ? r.non_servis.join(\", \") : \"Aucun\"}\n</p>\n\n<hr>\n<h2>Détail des tournées</h2>\n`;\n\nfor (const v of r.vehicules) {\n  const route = v.route.map(n =>\n    n === 0 ? \"Dépôt\" : \"Client \" + String(n).padStart(2, \"0\")\n  ).join(\" → \");\n\n  html += `\n    <h3>Véhicule ${v.vehicule}</h3>\n    <p><b>Itinéraire :</b> ${route}</p>\n    <p><b>Distance :</b> ${v.distance}</p>\n    <p><b>Charge :</b> ${v.charge}/${v.capacite}</p>\n    <p><b>Capacité respectée :</b> ${v.capacite_ok ? \"Oui\" : \"Non\"}</p>\n    <p><b>Fenêtres temporelles respectées :</b> ${v.fenetres_ok ? \"Oui\" : \"Non\"}</p>\n    <hr>\n  `;\n}\n\nreturn [{ json: { html } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
